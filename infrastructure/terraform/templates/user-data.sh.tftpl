#!/bin/bash
set -euo pipefail

dnf install -y docker jq
install -d -m 0755 /etc/docker
cat > /etc/docker/daemon.json <<'DOCKER_CONFIG'
{
  "log-driver": "local",
  "log-opts": {
    "max-file": "3",
    "max-size": "10m"
  }
}
DOCKER_CONFIG
systemctl enable --now docker

install -d -m 0700 /opt/dancingissogood
install -d -m 0755 /opt/dancingissogood/caddy

cat > /opt/dancingissogood/caddy/Caddyfile <<'CADDYFILE'
${api_domain} {
  encode zstd gzip
  reverse_proxy backend:3001

  header {
    -Server
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), geolocation=(), microphone=()"
  }
}
CADDYFILE

# Deployments (and the Caddy container) are managed by
# infrastructure/scripts/remote-deploy.sh, shipped over SSM on every deploy.
# Terraform ignores user_data changes on the instance, so this file only
# matters when the host is deliberately replaced.
