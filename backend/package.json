{
  "name": "@dancingissogood/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "dotenv -e .env -- tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "stripe:sync-pass": "dotenv -e .env -- tsx src/scripts/sync-stripe-pass.ts",
    "user:set-role": "dotenv -e .env -- tsx src/scripts/set-user-role.ts",
    "test": "dotenv -e .env.test -- tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit --project tsconfig.test.json",
    "lint": "eslint ."
  },
  "dependencies": {
    "@clerk/backend": "^3.31.2",
    "@clerk/fastify": "^3.1.104",
    "@dancingissogood/db": "*",
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.12.8",
    "fastify-raw-body": "^5.0.0",
    "luxon": "^3.7.2",
    "stripe": "^22.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.10.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "engines": {
    "node": ">=24.10.0"
  }
}
